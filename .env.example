# Copiar este archivo como .env y ajustar los valores. El archivo .env no se sube al repositorio.
# Lo usan docker-compose y la configuración de lanzamiento de VS Code.

# Clave con la que se firman los tokens de sesión (obligatoria): Base64 de al menos 32 bytes aleatorios.
# Se genera, por ejemplo, con: openssl rand -base64 64 | tr -d '\n'
# Al cambiarla, las sesiones abiertas se cierran y los usuarios vuelven a iniciar sesión.
JWT_SECRET=

# Administrador inicial: se crea al arrancar la aplicación si no existe
SGTG_ADMIN_EMAIL=admin@unicauca.edu.co
SGTG_ADMIN_PASSWORD=CambiarEstaClave123*

# Reloj ajustable (/api/v1/sgtg/reloj) para probar flujos que dependen del tiempo.
# docker-compose lo activa por defecto; nunca activarlo en producción.
SGTG_RELOJ_AJUSTABLE=true

# Directorio donde se guardan los archivos (PDF) de los trabajos de grado y tamaño máximo por archivo.
# En docker-compose el directorio es un volumen; para ejecución local por defecto es ./archivos
# SGTG_ARCHIVOS_DIRECTORIO=./archivos
# SGTG_ARCHIVOS_TAMANO_MAXIMO=20MB

# Registro de las consultas SQL para depurar (por defecto apagado); los parámetros incluyen datos personales
# SPRING_JPA_SHOW_SQL=true
# SGTG_LOG_PARAMETROS_SQL=trace
